# KidsControl agent configuration
# Copy to /etc/kidscontrol/client.env (Linux),
# %PROGRAMDATA%\KidsControl\client.env (Windows),
# or ~/.config/kidscontrol/client.env (macOS)

KIDSCONTROL_SERVER=http://127.0.0.1:8000
KIDSCONTROL_DEVICE_KEY=replace-with-device-key-from-parent-ui
KIDSCONTROL_POLL_SECONDS=30
# KIDSCONTROL_DRY_RUN=1
