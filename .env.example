# KidsControl environment example
# Copy to .env or export in the shell / systemd EnvironmentFile

# Bevorzugt: python -m app.setup
# Das schreibt data/server.env (Eltern-Login und Client-Setup-Passwort).

KIDSCONTROL_ADMIN_USER=admin
KIDSCONTROL_ADMIN_PASSWORD=change-me
KIDSCONTROL_SETUP_PASSWORD=change-me-too
# Wird von python -m app.setup erzeugt. Keinen der Beispielwerte verwenden.
# KIDSCONTROL_SECRET=
KIDSCONTROL_TZ=Europe/Berlin

# Optional: override data directory (SQLite + runtime files)
# KIDSCONTROL_DATA_DIR=./data

# Optional explicit DB URL (defaults to sqlite under data/)
# DATABASE_URL=sqlite:///./data/kidscontrol.sqlite3

HOST=0.0.0.0
PORT=8000
KIDSCONTROL_AGENT_POLL_SECONDS=30
