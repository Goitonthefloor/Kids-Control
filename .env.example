# Kids-Control Server Configuration

# Secret key for session management (change in production!)
KIDSCONTROL_SECRET=dev-secret-change-me

# Child view token (optional - for read-only child access)
KIDSCONTROL_CHILD_VIEW_TOKEN=

# Widget API token (optional - for KDE widget)
KIDSCONTROL_WIDGET_TOKEN=

# REMOVED: LDAP configuration no longer needed
# Authentication is now handled via database credentials
# Initial admin account:
#   Username: admin
#   Password: Admin
# IMPORTANT: Change the default password immediately after first login!
