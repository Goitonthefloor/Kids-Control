# Copy to .env.docker and replace both passwords before the first start.
KIDSCONTROL_ADMIN_USER=admin
KIDSCONTROL_ADMIN_PASSWORD=change-this-parent-password
KIDSCONTROL_SETUP_PASSWORD=change-this-client-setup-password
KIDSCONTROL_TZ=Europe/Berlin
# Optional host port: set KIDSCONTROL_BIND in the shell running docker compose.
