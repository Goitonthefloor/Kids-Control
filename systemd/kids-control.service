[Unit]
Description=KidsControl Hub (FastAPI/Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kidscontrol
Group=kidscontrol
WorkingDirectory=/opt/kids-control
# Python loads data/server.env. EnvironmentFile would expand $NAME inside
# the argon2id password hashes and the parent could no longer log in.
ExecStart=/opt/kids-control/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/kids-control/data
LockPersonality=true
RestrictRealtime=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
